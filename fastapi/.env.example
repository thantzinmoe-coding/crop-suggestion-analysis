# Copy this file to .env and update the MongoDB connection if needed.
AGROGUARD_MONGODB_URL=mongodb://localhost:27017
AGROGUARD_DATABASE_NAME=greenvista
AGROGUARD_INITIALIZE_DATABASE=true
AGROGUARD_CORS_ORIGINS=["http://localhost:5173"]

# Optional integrations
AGROGUARD_LLM_API_KEY=
AGROGUARD_LLM_ENDPOINT=https://api.openai.com/v1
AGROGUARD_LLM_MODEL=gpt-4o
AGROGUARD_OPENWEATHER_API_KEY=
AGROGUARD_TELEGRAM_BOT_TOKEN=
AGROGUARD_TELEGRAM_CHAT_ID=

# Optional near-real-time Sentinel-2 NDVI ingestion from Copernicus Data Space.
AGROGUARD_CDSE_ENABLED=false
AGROGUARD_CDSE_CLIENT_ID=
AGROGUARD_CDSE_CLIENT_SECRET=
AGROGUARD_CDSE_CLOUD_COVER_MAX=40

# SMTP email delivery (for example, Gmail app-password SMTP).
AGROGUARD_SMTP_HOST=smtp.gmail.com
AGROGUARD_SMTP_PORT=587
AGROGUARD_SMTP_USERNAME=
AGROGUARD_SMTP_PASSWORD=
AGROGUARD_SMTP_FROM_EMAIL=
AGROGUARD_SMTP_USE_TLS=true
