# Copy this file to .env and replace the placeholder values.
# Local MongoDB defaults. Replace the URL with a MongoDB Atlas URI when needed.
# Authenticated example: mongodb://username:password@127.0.0.1:27017/?authSource=admin
CROP_AI_MONGODB_URL=mongodb://127.0.0.1:27017
CROP_AI_MONGODB_DATABASE=crop_ai
CROP_AI_INITIALIZE_DATABASE=true
CROP_AI_CORS_ORIGINS=["http://localhost:5173"]

# Optional integrations
CROP_AI_LLM_API_KEY=
CROP_AI_LLM_ENDPOINT=https://api.openai.com/v1
CROP_AI_LLM_MODEL=gpt-4o
CROP_AI_OPENWEATHER_API_KEY=
CROP_AI_TELEGRAM_BOT_TOKEN=
CROP_AI_TELEGRAM_CHAT_ID=
