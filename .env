# Optional Compose port overrides
FRONTEND_PORT=5173
BACKEND_PORT=8000
MONGO_PORT=27017

# Local LLM defaults. Docker connects to the Ollama app running on Windows.
AGROGUARD_LLM_ENDPOINT=http://host.docker.internal:11434/v1
AGROGUARD_LLM_MODEL=gemma4:latest

# Optional OpenAI-compatible provider override. Leave these unset to use Ollama.
# AGROGUARD_LLM_ENDPOINT=https://api.openai.com/v1
# AGROGUARD_LLM_MODEL=gpt-4o-mini
# AGROGUARD_LLM_API_KEY=replace-with-your-key

# Optional integrations
# AGROGUARD_OPENWEATHER_API_KEY=
# AGROGUARD_CDSE_ENABLED=false
# AGROGUARD_CDSE_CLIENT_ID=
# AGROGUARD_CDSE_CLIENT_SECRET=
# AGROGUARD_SMTP_HOST=smtp.gmail.com
# AGROGUARD_SMTP_PORT=587
# AGROGUARD_SMTP_USERNAME=
# AGROGUARD_SMTP_PASSWORD=
# AGROGUARD_SMTP_FROM_EMAIL=
